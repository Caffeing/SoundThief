		{"id":"e3","fromNode":"carry","fromSide":"bottom","toNode":"release","toSide":"top","label":"투척 사용"},
		{"id":"e4","fromNode":"release","fromSide":"bottom","toNode":"normal","toSide":"top","label":"착지 또는 시간 만료 폭발 후 관계 복구"},
		{"id":"e5","fromNode":"carry","fromSide":"bottom","toNode":"burst","toSide":"top","label":"제한 시간 초과"},
		{"id":"e6","fromNode":"inject","fromSide":"bottom","toNode":"guard","toSide":"top","label":"현재 출력 등급·거리"},
