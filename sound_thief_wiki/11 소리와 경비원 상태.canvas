		{"id":"e8","fromNode":"inject","fromSide":"bottom","toNode":"ready","toSide":"top","label":"주입 후 즉시"},
		{"id":"e10","fromNode":"burst","fromSide":"left","toNode":"normal","toSide":"bottom","label":"원래 관계 즉시 복구"},
		{"id":"e11","fromNode":"release","fromSide":"bottom","toNode":"airburst","toSide":"left","label":"착지 전 제한 시간 만료"},
