  letterId: 3
  recipient: "\uB85C\uC5B8"
  sender: "\uBC14\uC9C8"
  body: "\uB85C\uC5B8!\n\n\uBE4C\uB824 \uAC04 \uB0B4 \uB178\uB780 \uC6B0\uC0B0\uC740
    \uB300\uCCB4 \uC5B8\uC81C \uB3CC\uB824\uC904 \uAC70\uC57C?\n\uBE44\uB9CC \uC624\uBA74
    \uC591\uB9D0\uBD80\uD130 \uC816\uB294\uB2E4\uACE0!\n\uB0B4\uC77C\uAE4C\uC9C0
    \uC548 \uB3CC\uB824\uC8FC\uBA74 \uB124 \uC7A5\uD654\uC5D0 \uBB3C\uC744 \uAC00\uB4DD
    \uCC44\uC6CC \uB193\uACA0\uC5B4.\n\uC774\uAC74 \uB18D\uB2F4\uC774 \uC544\uB2C8\uC57C.
    \uC544\uB9C8\uB3C4!\n\n\uC794\uB729 \uC2EC\uD1B5 \uB09C \uBC14\uC9C8"
  isObjective: 1
