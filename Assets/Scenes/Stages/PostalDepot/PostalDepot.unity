  m_Script: {fileID: 11500000, guid: acbc30152174e4df5a77bf874249a254, type: 3}
  m_Name: 
  m_EditorClassIdentifier: SoundThief.PostalDepot::SoundThief.PostalDepot.PostalLetter
  letterId: 4
  recipient: "\uB8E8\uCE74"
  sender: "\uB9C8\uC77C\uB85C"
  body: "\uB8E8\uCE74, \uD56D\uAD6C\uC5D0\uC11C \uD2B9\uAE09 \uC18C\uC2DD\uC774\uB2E4!\n\n\uC624\uB298
    \uAC70\uB300\uD55C \uBC14\uB2E4 \uAD34\uBB3C\uACFC \uB9DE\uC11C \uC2F8\uC6E0\uC9C0.\n\uC815\uD655\uD788
    \uB9D0\uD558\uBA74 \uB0B4 \uC810\uC2EC\uC744 \uB178\uB9B0 \uAC08\uB9E4\uAE30
    \uD55C \uB9C8\uB9AC\uC600\uC9C0\uB9CC!\n\uC0CC\uB4DC\uC704\uCE58\uB294 \uC783\uC5C8\uACE0
    \uBAA8\uC790\uB294 \uB418\uCC3E\uC558\uB2E4. \uBB34\uC2B9\uBD80\uB85C \uAE30\uB85D\uD574
    \uC918.\n\n\uC704\uB300\uD55C \uC120\uC7A5 \uB9C8\uC77C\uB85C"
  isObjective: 0
