  m_Name: 
  m_EditorClassIdentifier: SoundThief.PostalDepot::SoundThief.PostalDepot.PostalLetter
  letterId: 2
  recipient: "\uC140\uB808\uC2A4\uD2B8"
  sender: "\uBC14\uB10C \uACF5\uBC29"
  body: "\uC140\uB808\uC2A4\uD2B8 \uB2D8\uAED8.\n\n\uC8FC\uBB38\uD558\uC2E0 \uB9DD\uC6D0\uACBD\uC6A9
    \uD669\uB3D9 \uB098\uC0AC 12\uAC1C\uB97C \uBC1C\uC1A1\uD569\uB2C8\uB2E4.\n\uB3D9\uBD09\uD55C
    \uADDC\uACA9\uD45C\uC640 \uC218\uB7C9\uC744 \uD655\uC778\uD574 \uC8FC\uC2ED\uC2DC\uC624.\n\uC791\uC740
    \uBD80\uD488\uC774\uBBC0\uB85C \uC791\uC5C5 \uC911\uC5D0\uB294 \uC7C1\uBC18\uC744
    \uC0AC\uC6A9\uD558\uC2DC\uAE30 \uBC14\uB78D\uB2C8\uB2E4.\n\n\uBC14\uB10C \uACF5\uBC29
    \uBC30\uC1A1 \uB2F4\uB2F9"
  isObjective: 0
