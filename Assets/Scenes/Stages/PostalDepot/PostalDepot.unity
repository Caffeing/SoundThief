  m_Name: 
  m_EditorClassIdentifier: SoundThief.PostalDepot::SoundThief.PostalDepot.PostalLetter
  letterId: 1
  recipient: "\uC62C\uB9AC\uBC84"
  sender: "\uD53C\uD30C"
  body: "\uC62C\uB9AC\uBC84, \uD1A0\uC694\uC77C\uC5D4 \uBC30\uB97C \uBE44\uC6CC \uB46C!\n\n\uC6B0\uB9AC
    \uBE75\uC9D1\uC5D0\uC11C \uB538\uAE30 \uD0C0\uB974\uD2B8 \uC2DC\uC2DD\uD68C\uB97C
    \uC5F4\uC5B4.\n\uC785\uC7A5\uB8CC\uB294 \uC0C8\uB85C \uB9CC\uB4E0 \uBE75 \uC774\uB984
    \uD558\uB098\uC57C.\n\uB098\uB294 '\uC640\uC0AD\uC640\uC0AD \uAD6C\uB984'\uC5D0
    \uD55C \uD45C! \uB9DB\uC788\uB294 \uC774\uB984\uC744 \uC0DD\uAC01\uD574 \uC640.\n\n\uBC00\uAC00\uB8E8\uD22C\uC131\uC774
    \uD53C\uD30C\uAC00"
  isObjective: 0
