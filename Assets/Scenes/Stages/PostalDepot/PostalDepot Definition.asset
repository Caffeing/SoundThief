  m_Name: PostalDepot Definition
  m_EditorClassIdentifier: SoundThief.Runtime::SoundThief.StageDefinition
  stageId: gganwoor-postal-depot
  title: "\uC544\uC9C1 \uBCF4\uB0B4\uC9C0 \uB9C8\uC138\uC694!"
  briefing: "\uD667\uAE40\uC5D0 \uBCF4\uB0B8 \uD3B8\uC9C0\uB97C \uB418\uCC3E\uC544
    \uC8FC\uC138\uC694. \uC811\uC218\uB300\uC758 \uC9C1\uC6D0 \uC5F4\uC1E0\uB97C
    \uCC3E\uACE0, \uBD84\uB958 \uC791\uC5C5\uC2E4\uC5D0\uC11C \uBD84\uB958\uD45C\uB97C
    \uD655\uC778\uD55C \uB4A4 B\uAD6C\uC5ED\uC758 \uBD89\uC740 \uBD09\uC778 \uD3B8\uC9C0\uB97C
    \uD68C\uC218\uD574 \uC55E\uB9C8\uB2F9\uC73C\uB85C \uB3CC\uC544\uC624\uC138\uC694.
    \uC2E4\uC81C \uC81C\uD55C \uC2DC\uAC04\uC740 \uC5C6\uC2B5\uB2C8\uB2E4."
  requiredItemIds:
  - postal_route_note
  - postal_unsent_letter
  objectiveText: "\uBD84\uB958\uD45C\uB97C \uD655\uC778\uD558\uACE0 \uBD89\uC740
    \uBD09\uC778 \uD3B8\uC9C0\uB97C \uD68C\uC218\uD558\uC138\uC694."
  exitText: "\uC55E\uB9C8\uB2F9\uC758 \uCD08\uB85D \uCD9C\uAD6C\uC5D0\uC11C F\uB85C
    \uD0C8\uCD9C\uD558\uC138\uC694."
  startImmediately: 1
