  m_Name: TaehyeonStage Definition
  m_EditorClassIdentifier: SoundThief.Runtime::SoundThief.StageDefinition
  stageId: taehyeon_manor_seal
  title: "\uD0DC\uD604 \uC800\uD0DD\uC758 \uC778\uC7A5"
  briefing: "\uB2EC\uBE5B \uC544\uB798 \uC7A0\uB4E0 \uB300\uC800\uD0DD\uC5D0 \uC7A0\uC785\uD558\uC138\uC694. \uB0A8\uCABD \uBCF4\uAD00\uC2E4\uC758 \uC5F4\uC1E0\uB85C \uC911\uC559 \uBB38\uC744 \uC5F4\uACE0, \uC11C\uACE0\xB7\uC804\uC2DC\uC2E4\xB7\uC2DC\uACC4\uC2E4\uC758 \uC18C\uB9AC\uB97C \uB2E4\uB8E8\uBA70 \uACBD\uBE44\uB97C \uD53C\uD574 \uBD81\uCABD \uAE08\uACE0\uC758 \uD0DC\uD604 \uC778\uC7A5\uC744 \uD68C\uC218\uD55C \uB4A4 \uC815\uBB38\uC73C\uB85C \uB3CC\uC544\uC624\uC138\uC694."
  requiredItemIds:
  - taehyeon_seal
  objectiveText: "\uC5F4\uC1E0\uB85C \uC911\uC559 \uBB38\uC744 \uC5F4\uACE0 \uBD81\uCABD \uAE08\uACE0\uC758 \uD0DC\uD604 \uC778\uC7A5\uC744 \uD68C\uC218\uD558\uC138\uC694."
  exitText: "\uC778\uC7A5\uC744 \uB4E4\uACE0 \uB0A8\uCABD \uC815\uBB38 \uCD9C\uAD6C\uC5D0\uC11C F\uB85C \uD0C8\uCD9C\uD558\uC138\uC694."
  startImmediately: 1
